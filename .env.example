# Copiar a .env y ajustar. Nunca subir .env a git.

# --- ingestion-go ---
HTTP_ADDR=:8080
ANALYTICS_URL=http://analytics:8081
SCHEMAS_DIR=/app/contracts/schemas
ANALYZER_WORKERS=4
INGEST_QUEUE_SIZE=1024
MATCH_QUEUE_SIZE=256
INGEST_ENQUEUE_TIMEOUT=2s
MATCH_GRACE_PERIOD=2s
MATCH_IDLE_TIMEOUT=60s
ANALYZE_TIMEOUT=5s
ANALYZE_MAX_RETRIES=3
ANALYZE_BACKOFF_BASE=500ms
MAX_EVENTS_PER_MATCH=10000
# Vacío = resultados solo en memoria
RESULTS_DIR=
SHUTDOWN_TIMEOUT=10s
SHUTDOWN_ANALYZE_INCOMPLETE=true
# Vacío = sin autenticación (solo local). Definir en deployment.
INGEST_API_KEY=
LOG_LEVEL=info

# --- analytics-scala ---
HTTP_PORT=8081
JAVA_OPTS=-XX:MaxRAMPercentage=75

# --- simulator ---
TARGET_URL=http://ingestion:8080
SCENARIO=demo
SEED=42
SPEED=10

# --- deployment ---
GHCR_OWNER=
IMAGE_TAG=latest
